# 本機設定（start.bat、server.py、wsl/*.sh 都會讀這個檔）
# 格式：KEY=VALUE，不要加引號；留空 = 用預設值。系統環境變數優先於這裡。

# 跑 Whisper 字詞對齊的 Python（需裝 openai-whisper）；留空則用字數比例估計
ALIGNER_PYTHON=C:\path\to\ComfyUI_windows_portable\python_embeded\python.exe

# WSL 內 BreezyVoice 安裝目錄；留空 = ~/tts/BreezyVoice
BREEZY_DIR=

# start.bat 使用的 WSL 發行版；留空 = Ubuntu
WSL_DISTRO=Ubuntu
